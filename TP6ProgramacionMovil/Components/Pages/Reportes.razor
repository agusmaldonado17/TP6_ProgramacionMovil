@page "/reportes"

@using TP6ProgramacionMovil.Services
@using Microsoft.Maui.ApplicationModel
@using Microsoft.Maui.Storage

@inject ReporteService ReporteService
@inject AuthService AuthService
@inject NavigationManager Navigation


<MudStack Spacing="4">

    <div>

        <MudText Typo="Typo.h4">
            Reportes
        </MudText>

        <MudText Typo="Typo.body1"
                 Color="Color.Secondary">
            Generá o enviá reportes del sistema
        </MudText>

    </div>


    @if (cargando)
    {
        <div class="d-flex justify-center pa-8">

            <MudProgressCircular Indeterminate="true"
                                 Color="Color.Primary"
                                 Size="Size.Large" />

        </div>
    }
    else if (!AuthService.EsAdmin)
    {
        <MudAlert Severity="Severity.Error">
            No tenés permisos para acceder a esta sección.
        </MudAlert>
    }
    else
    {
        @if (!string.IsNullOrEmpty(mensaje))
        {
            <MudAlert Severity="Severity.Success">
                @mensaje
            </MudAlert>
        }

        @if (!string.IsNullOrEmpty(error))
        {
            <MudAlert Severity="Severity.Error">
                @error
            </MudAlert>
        }


        <MudGrid>

            <MudItem xs="12" md="4">

                <MudCard Style="height:100%; border-radius:18px;">

                    <MudCardContent>

                        <MudIcon Icon="@Icons.Material.Filled.Inventory2"
                                 Size="Size.Large"
                                 Color="Color.Primary"
                                 Class="mb-3" />

                        <MudText Typo="Typo.h6">
                            Stock
                        </MudText>

                        <MudText Typo="Typo.body2"
                                 Color="Color.Secondary">
                            Estado actual del stock de productos.
                        </MudText>

                    </MudCardContent>

                    <MudCardActions>

                        <MudButton Color="Color.Primary"
                                   Variant="Variant.Filled"
                                   Disabled="@procesando"
                                   OnClick='() => AbrirReporte("stock")'>

                            Abrir PDF

                        </MudButton>

                    </MudCardActions>

                </MudCard>

            </MudItem>


            <MudItem xs="12" md="4">

                <MudCard Style="height:100%; border-radius:18px;">

                    <MudCardContent>

                        <MudIcon Icon="@Icons.Material.Filled.ReceiptLong"
                                 Size="Size.Large"
                                 Color="Color.Primary"
                                 Class="mb-3" />

                        <MudText Typo="Typo.h6">
                            Ventas
                        </MudText>

                        <MudText Typo="Typo.body2"
                                 Color="Color.Secondary">
                            Listado de ventas registradas.
                        </MudText>

                    </MudCardContent>

                    <MudCardActions>

                        <MudButton Color="Color.Primary"
                                   Variant="Variant.Filled"
                                   Disabled="@procesando"
                                   OnClick='() => AbrirReporte("ventas")'>

                            Abrir PDF

                        </MudButton>

                    </MudCardActions>

                </MudCard>

            </MudItem>


            <MudItem xs="12" md="4">

                <MudCard Style="height:100%; border-radius:18px;">

                    <MudCardContent>

                        <MudIcon Icon="@Icons.Material.Filled.LocalShipping"
                                 Size="Size.Large"
                                 Color="Color.Primary"
                                 Class="mb-3" />

                        <MudText Typo="Typo.h6">
                            Entradas
                        </MudText>

                        <MudText Typo="Typo.body2"
                                 Color="Color.Secondary">
                            Entradas de mercadería registradas.
                        </MudText>

                    </MudCardContent>

                    <MudCardActions>

                        <MudButton Color="Color.Primary"
                                   Variant="Variant.Filled"
                                   Disabled="@procesando"
                                   OnClick='() => AbrirReporte("entradas")'>

                            Abrir PDF

                        </MudButton>

                    </MudCardActions>

                </MudCard>

            </MudItem>

        </MudGrid>


        <MudPaper Elevation="1"
                  Class="pa-5"
                  Style="border-radius:20px;">

            <MudStack Spacing="4">

                <div>

                    <MudText Typo="Typo.h6">
                        Enviar por correo
                    </MudText>

                    <MudText Typo="Typo.body2"
                             Color="Color.Secondary">
                        El PDF será generado y enviado como archivo adjunto
                    </MudText>

                </div>


                <MudTextField T="string"
                              @bind-Value="email"
                              Label="Correo electrónico"
                              Variant="Variant.Outlined"
                              InputType="InputType.Email"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Email" />


                <MudSelect T="string"
                           @bind-Value="tipoReporte"
                           Label="Tipo de reporte"
                           Variant="Variant.Outlined">

                    <MudSelectItem T="string"
                                   Value="@string.Empty">
                        Seleccionar...
                    </MudSelectItem>

                    <MudSelectItem T="string"
                                   Value="@("stock")">
                        Stock
                    </MudSelectItem>

                    <MudSelectItem T="string"
                                   Value="@("ventas")">
                        Ventas
                    </MudSelectItem>

                    <MudSelectItem T="string"
                                   Value="@("entradas")">
                        Entradas
                    </MudSelectItem>

                </MudSelect>


                <MudButton Variant="Variant.Filled"
                           Color="Color.Success"
                           Size="Size.Large"
                           FullWidth="true"
                           Disabled="@procesando"
                           StartIcon="@Icons.Material.Filled.Send"
                           OnClick="EnviarReporte">

                    @(procesando
                        ? "Procesando..."
                        : "Enviar reporte")

                </MudButton>

            </MudStack>

        </MudPaper>
    }

</MudStack>


@code {

    private bool cargando = true;
    private bool procesando;

    private string email = "";
    private string tipoReporte = "";

    private string mensaje = "";
    private string error = "";


    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.EstaAutenticado)
        {
            var sesion =
                await AuthService.RestaurarSesionAsync();

            if (!sesion)
            {
                Navigation.NavigateTo(
                    "/login",
                    replace: true
                );

                return;
            }
        }

        cargando = false;
    }


    private async Task AbrirReporte(string tipo)
    {
        mensaje = "";
        error = "";
        procesando = true;

        try
        {
            var pdf =
                await ReporteService
                    .ObtenerPdfAsync(tipo);

            var nombreArchivo =
                $"{tipo}.pdf";

            var ruta =
                Path.Combine(
                    FileSystem.CacheDirectory,
                    nombreArchivo
                );

            await File.WriteAllBytesAsync(
                ruta,
                pdf
            );

            await Launcher.Default.OpenAsync(
                new OpenFileRequest(
                    "Abrir reporte",
                    new ReadOnlyFile(ruta)
                )
            );
        }
        catch (Exception ex)
        {
            error =
                $"No se pudo abrir el reporte: {ex.Message}";
        }
        finally
        {
            procesando = false;
        }
    }


    private async Task EnviarReporte()
    {
        mensaje = "";
        error = "";

        if (string.IsNullOrWhiteSpace(email))
        {
            error =
                "Debe ingresar un correo electrónico.";

            return;
        }

        if (string.IsNullOrWhiteSpace(tipoReporte))
        {
            error =
                "Debe seleccionar un tipo de reporte.";

            return;
        }

        procesando = true;

        try
        {
            mensaje =
                await ReporteService
                    .EnviarReporteAsync(
                        email,
                        tipoReporte
                    );
        }
        catch (Exception ex)
        {
            error =
                $"No se pudo enviar el reporte: {ex.Message}";
        }
        finally
        {
            procesando = false;
        }
    }
}