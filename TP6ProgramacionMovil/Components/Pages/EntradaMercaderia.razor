@page "/entrada-mercaderia"

@using TP6ProgramacionMovil.Models
@using TP6ProgramacionMovil.Services

@inject AuthService AuthService
@inject ProductoService ProductoService
@inject ProveedorService ProveedorService
@inject CompraService CompraService
@inject NavigationManager Navigation
@inject CategoriaService CategoriaService


<MudStack Spacing="4">

    <div>

        <MudText Typo="Typo.h4">
            Entrada de mercadería
        </MudText>

        <MudText Typo="Typo.body1"
                 Color="Color.Secondary">
            Registrá productos recibidos y actualizá el stock
        </MudText>

    </div>


    @if (cargando)
    {
        <div class="d-flex justify-center pa-8">

            <MudProgressCircular Indeterminate="true"
                                 Color="Color.Primary"
                                 Size="Size.Large" />

        </div>
    }
    else if (!AuthService.EsAdmin)
    {
        <MudAlert Severity="Severity.Error">
            No tenés permisos para acceder a esta sección.
        </MudAlert>
    }
    else if (entradaExitosa)
    {
        <MudPaper Elevation="1"
                  Class="pa-6"
                  Style="border-radius:20px;">

            <MudStack AlignItems="AlignItems.Center"
                      Spacing="3">

                <MudAvatar Color="Color.Success"
                           Size="Size.Large">

                    <MudIcon Icon="@Icons.Material.Filled.Check" />

                </MudAvatar>

                <MudText Typo="Typo.h5">
                    Entrada registrada correctamente
                </MudText>

                <MudText>
                    Entrada N°
                    <strong>@compraId</strong>
                </MudText>

                <MudText Typo="Typo.h4"
                         Color="Color.Success">
                    $@totalCompra.ToString("N2")
                </MudText>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           OnClick="NuevaEntrada">

                    Registrar otra entrada

                </MudButton>

            </MudStack>

        </MudPaper>
    }
    else
    {
        @if (!string.IsNullOrEmpty(error))
        {
            <MudAlert Severity="Severity.Error">
                @error
            </MudAlert>
        }


        <MudPaper Elevation="1"
                  Class="pa-5"
                  Style="border-radius:20px;">

            <MudStack Spacing="4">

                <MudText Typo="Typo.h6">
                    Datos de la entrada
                </MudText>


                <MudSelect T="int"
                           Label="Proveedor"
                           Variant="Variant.Outlined"
                           @bind-Value="proveedorId">

                    <MudSelectItem T="int"
                                   Value="0">
                        Seleccionar proveedor...
                    </MudSelectItem>

                    @foreach (var proveedor in proveedores)
                    {
                        <MudSelectItem T="int"
                                       Value="@proveedor.Id">
                            @proveedor.RazonSocial
                        </MudSelectItem>
                    }

                </MudSelect>

            </MudStack>

        </MudPaper>


        <MudPaper Elevation="1"
                  Class="pa-5"
                  Style="border-radius:20px;">

            <MudStack Spacing="4">

                <MudStack Row="true"
                          Justify="Justify.SpaceBetween"
                          AlignItems="AlignItems.Center">

                    <MudText Typo="Typo.h6">
                        Agregar producto
                    </MudText>

                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="ToggleNuevoProducto">

                        @(mostrarNuevoProducto
                            ? "Cancelar"
                            : "Nuevo producto")

                    </MudButton>

                </MudStack>


                @if (mostrarNuevoProducto)
                {
                    <MudPaper Elevation="0"
                              Class="pa-4"
                              Style="background:#F8FAFC; border-radius:16px;">

                        <MudStack Spacing="3">

                            <MudText Typo="Typo.subtitle1">
                                Crear producto nuevo
                            </MudText>


                            <MudTextField T="string"
                                          @bind-Value="nuevoNombre"
                                          Label="Nombre"
                                          Variant="Variant.Outlined" />


                            <MudTextField T="string"
                                          @bind-Value="nuevoDescripcion"
                                          Label="Descripción"
                                          Variant="Variant.Outlined" />


                            <MudSelect T="int"
                                       @bind-Value="nuevaCategoriaId"
                                       Label="Categoría"
                                       Variant="Variant.Outlined">

                                <MudSelectItem T="int"
                                               Value="0">
                                    Seleccionar categoría...
                                </MudSelectItem>

                                @foreach (var categoria in categorias)
                                {
                                    <MudSelectItem T="int"
                                                   Value="@categoria.Id">
                                        @categoria.Nombre
                                    </MudSelectItem>
                                }

                            </MudSelect>


                            <MudGrid>

                                <MudItem xs="12" sm="4">

                                    <MudNumericField T="decimal"
                                                     @bind-Value="nuevoPrecioVenta"
                                                     Label="Precio de venta"
                                                     Variant="Variant.Outlined" />

                                </MudItem>


                                <MudItem xs="12" sm="4">

                                    <MudNumericField T="int"
                                                     @bind-Value="nuevoPuntoReposicion"
                                                     Label="Punto de reposición"
                                                     Variant="Variant.Outlined" />

                                </MudItem>


                                <MudItem xs="12" sm="4">

                                    <MudNumericField T="int"
                                                     @bind-Value="nuevoStockMaximo"
                                                     Label="Stock máximo"
                                                     Variant="Variant.Outlined" />

                                </MudItem>

                            </MudGrid>


                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Success"
                                       FullWidth="true"
                                       Disabled="@creandoProducto"
                                       OnClick="CrearNuevoProducto">

                                @(creandoProducto
                                    ? "Creando..."
                                    : "Crear producto")

                            </MudButton>

                        </MudStack>

                    </MudPaper>
                }


                <MudSelect T="int"
                           @bind-Value="productoId"
                           Label="Producto"
                           Variant="Variant.Outlined">

                    <MudSelectItem T="int"
                                   Value="0">
                        Seleccionar producto...
                    </MudSelectItem>

                    @foreach (var producto in productos)
                    {
                        <MudSelectItem T="int"
                                       Value="@producto.Id">
                            @producto.Nombre
                        </MudSelectItem>
                    }

                </MudSelect>


                <MudGrid>

                    <MudItem xs="12" sm="6">

                        <MudNumericField T="int"
                                         @bind-Value="cantidad"
                                         Label="Cantidad"
                                         Variant="Variant.Outlined" />

                    </MudItem>


                    <MudItem xs="12" sm="6">

                        <MudNumericField T="decimal"
                                         @bind-Value="precioUnitario"
                                         Label="Precio de compra unitario"
                                         Variant="Variant.Outlined" />

                    </MudItem>

                </MudGrid>


                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           StartIcon="@Icons.Material.Filled.AddShoppingCart"
                           OnClick="AgregarProducto">

                    Agregar a la entrada

                </MudButton>

            </MudStack>

        </MudPaper>


        @if (items.Count > 0)
        {
            <div>

                <MudText Typo="Typo.h6"
                         Class="mb-3">
                    Productos de la entrada
                </MudText>


                <MudStack Spacing="2">

                    @foreach (var item in items)
                    {
                        <MudPaper Elevation="1"
                                  Class="pa-4"
                                  Style="border-radius:16px;">

                            <MudStack Row="true"
                                      Justify="Justify.SpaceBetween"
                                      AlignItems="AlignItems.Center">

                                <div>

                                    <MudText Typo="Typo.subtitle1">
                                        @item.Producto.Nombre
                                    </MudText>

                                    <MudText Typo="Typo.body2"
                                             Color="Color.Secondary">

                                        @item.Cantidad x
                                        $@item.PrecioUnitario.ToString("N2")

                                    </MudText>

                                    <MudText Typo="Typo.subtitle2">
                                        Subtotal:
                                        $@item.Subtotal.ToString("N2")
                                    </MudText>

                                </div>


                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Color="Color.Error"
                                               OnClick="@(() => EliminarItem(item))" />

                            </MudStack>

                        </MudPaper>
                    }

                </MudStack>

            </div>


            <MudPaper Elevation="2"
                      Class="pa-5"
                      Style="border-radius:20px;">

                <MudStack Spacing="3">

                    <MudStack Row="true"
                              Justify="Justify.SpaceBetween"
                              AlignItems="AlignItems.Center">

                        <MudText Typo="Typo.h6">
                            Total
                        </MudText>

                        <MudText Typo="Typo.h4"
                                 Color="Color.Primary">
                            $@Total.ToString("N2")
                        </MudText>

                    </MudStack>


                    @if (proveedorId == 0)
                    {
                        <MudAlert Severity="Severity.Warning">
                            Seleccioná un proveedor para registrar la entrada.
                        </MudAlert>
                    }


                    <MudButton Variant="Variant.Filled"
                               Color="Color.Success"
                               Size="Size.Large"
                               FullWidth="true"
                               Disabled="@(procesando || proveedorId == 0)"
                               StartIcon="@Icons.Material.Filled.Save"
                               OnClick="RegistrarEntrada">

                        @(procesando
                            ? "Registrando..."
                            : "Registrar entrada")

                    </MudButton>

                </MudStack>

            </MudPaper>
        }
    }

</MudStack>


@code {

    private List<ProveedorResponse> proveedores = new();
    private List<ProductoResponse> productos = new();
    private List<ItemEntrada> items = new();
    private List<CategoriaResponse> categorias = new();

    private int proveedorId;
    private int productoId;
    private int cantidad = 1;

    private decimal precioUnitario;

    private bool cargando = true;
    private bool procesando;
    private bool entradaExitosa;

    private string error = "";

    private int compraId;
    private decimal totalCompra;

    private bool mostrarNuevoProducto;

    private string nuevoNombre = "";
    private string nuevoDescripcion = "";

    private decimal nuevoPrecioVenta;

    private int nuevoPuntoReposicion;
    private int nuevoStockMaximo;
    private int nuevaCategoriaId;

    private bool creandoProducto;


    private decimal Total =>
        items.Sum(i => i.Subtotal);


    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.EstaAutenticado)
        {
            var sesion =
                await AuthService.RestaurarSesionAsync();

            if (!sesion)
            {
                Navigation.NavigateTo(
                    "/login",
                    replace: true
                );

                return;
            }
        }

        if (!AuthService.EsAdmin)
        {
            cargando = false;
            return;
        }

        try
        {
            proveedores =
                await ProveedorService
                    .ObtenerProveedoresAsync();

            categorias =
                await CategoriaService
                    .ObtenerCategoriasAsync();

            var respuestaProductos =
                await ProductoService
                    .ObtenerProductosAsync(
                        1,
                        50
                    );

            productos =
                respuestaProductos?.Datos
                    .Where(p => p.Activo)
                    .ToList()
                ?? new();
        }
        catch (Exception ex)
        {
            error =
                $"Error al cargar datos: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }


    private void AgregarProducto()
    {
        error = "";

        if (productoId == 0)
        {
            error =
                "Debe seleccionar un producto.";

            return;
        }

        if (cantidad <= 0)
        {
            error =
                "La cantidad debe ser mayor a cero.";

            return;
        }

        if (precioUnitario <= 0)
        {
            error =
                "El precio debe ser mayor a cero.";

            return;
        }

        var producto =
            productos.FirstOrDefault(
                p => p.Id == productoId
            );

        if (producto == null)
            return;

        var existente =
            items.FirstOrDefault(
                i => i.Producto.Id == productoId
            );

        if (existente != null)
        {
            existente.Cantidad += cantidad;
            existente.PrecioUnitario =
                precioUnitario;
        }
        else
        {
            items.Add(
                new ItemEntrada
                {
                    Producto = producto,
                    Cantidad = cantidad,
                    PrecioUnitario =
                        precioUnitario
                }
            );
        }

        productoId = 0;
        cantidad = 1;
        precioUnitario = 0;
    }


    private void EliminarItem(
        ItemEntrada item)
    {
        items.Remove(item);
    }


    private async Task RegistrarEntrada()
    {
        error = "";

        if (proveedorId == 0)
        {
            error =
                "Debe seleccionar un proveedor.";

            return;
        }

        if (items.Count == 0)
        {
            error =
                "Debe agregar al menos un producto.";

            return;
        }

        procesando = true;

        try
        {
            var compra =
                new CompraRequest
                {
                    ProveedorId =
                        proveedorId,

                    Detalles =
                        items.Select(i =>
                            new DetalleCompraRequest
                            {
                                ProductoId =
                                    i.Producto.Id,

                                Cantidad =
                                    i.Cantidad,

                                PrecioUnitario =
                                    i.PrecioUnitario
                            })
                        .ToList()
                };

            var resultado =
                await CompraService
                    .RegistrarCompraAsync(
                        compra
                    );

            compraId =
                resultado.CompraId;

            totalCompra =
                resultado.Total;

            entradaExitosa = true;
        }
        catch (Exception ex)
        {
            error =
                $"No se pudo registrar la entrada: {ex.Message}";
        }
        finally
        {
            procesando = false;
        }
    }


    private void NuevaEntrada()
    {
        proveedorId = 0;
        productoId = 0;
        cantidad = 1;
        precioUnitario = 0;

        items.Clear();

        entradaExitosa = false;
        error = "";
    }


    private void ToggleNuevoProducto()
    {
        mostrarNuevoProducto =
            !mostrarNuevoProducto;
    }


    private async Task CrearNuevoProducto()
    {
        error = "";

        if (string.IsNullOrWhiteSpace(
                nuevoNombre))
        {
            error =
                "Debe ingresar el nombre del producto.";

            return;
        }

        if (nuevaCategoriaId == 0)
        {
            error =
                "Debe seleccionar una categoría.";

            return;
        }

        if (nuevoPrecioVenta <= 0)
        {
            error =
                "El precio de venta debe ser mayor a cero.";

            return;
        }

        if (nuevoStockMaximo <= 0)
        {
            error =
                "El stock máximo debe ser mayor a cero.";

            return;
        }

        creandoProducto = true;

        try
        {
            var request =
                new ProductoRequest
                {
                    Nombre =
                        nuevoNombre,

                    Descripcion =
                        nuevoDescripcion,

                    PrecioVenta =
                        nuevoPrecioVenta,

                    StockActual = 0,

                    PuntoReposicion =
                        nuevoPuntoReposicion,

                    StockMaximo =
                        nuevoStockMaximo,

                    Activo = true,

                    CategoriaProductoId =
                        nuevaCategoriaId
                };


            var nuevo =
                await ProductoService
                    .CrearProductoAsync(
                        request
                    );

            productos.Add(nuevo);

            productoId =
                nuevo.Id;

            mostrarNuevoProducto =
                false;

            nuevoNombre = "";
            nuevoDescripcion = "";
            nuevoPrecioVenta = 0;
            nuevoPuntoReposicion = 0;
            nuevoStockMaximo = 0;
            nuevaCategoriaId = 0;
        }
        catch (Exception ex)
        {
            error =
                $"No se pudo crear el producto: {ex.Message}";
        }
        finally
        {
            creandoProducto = false;
        }
    }
}