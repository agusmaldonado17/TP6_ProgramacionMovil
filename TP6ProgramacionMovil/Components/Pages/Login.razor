@page "/"
@page "/login"

@inject AuthService AuthService
@inject NavigationManager Navigation

<div style="min-height: 90vh;"
     class="d-flex align-center justify-center">

    <MudPaper Elevation="6"
              Class="pa-8"
              Style="width: 100%; max-width: 430px; border-radius: 20px;">

        <MudStack Spacing="4">

            <div class="text-center">

                <MudAvatar Color="Color.Primary"
                           Size="Size.Large"
                           Class="mx-auto mb-3">

                    <MudIcon Icon="@Icons.Material.Filled.Storefront" />

                </MudAvatar>

                <MudText Typo="Typo.h4">
                    App de Stock
                </MudText>

                <MudText Typo="Typo.body2"
                         Color="Color.Secondary">

                    Ingresá con tu usuario para continuar

                </MudText>

            </div>


            <MudTextField T="string"
                          @bind-Value="username"
                          Label="Usuario"
                          Variant="Variant.Outlined"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Person"
                          Disabled="@procesando" />


            <MudTextField T="string"
                          @bind-Value="password"
                          Label="Contraseña"
                          Variant="Variant.Outlined"
                          InputType="InputType.Password"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Lock"
                          Disabled="@procesando" />


            @if (!string.IsNullOrEmpty(mensaje))
            {
                <MudAlert Severity="Severity.Error"
                          Variant="Variant.Outlined">

                    @mensaje

                </MudAlert>
            }


            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Size="Size.Large"
                       FullWidth="true"
                       Disabled="@procesando"
                       OnClick="IniciarSesion">

                @if (procesando)
                {
                    <MudProgressCircular Indeterminate="true"
                                         Size="Size.Small"
                                         Class="mr-2" />

                    <span>Ingresando...</span>
                }
                else
                {
                    <span>Iniciar sesión</span>
                }

            </MudButton>

        </MudStack>

    </MudPaper>

</div>


@code {

    private string username = "";
    private string password = "";
    private string mensaje = "";

    private bool procesando;


    protected override async Task OnInitializedAsync()
    {
        var sesionExiste =
            await AuthService.RestaurarSesionAsync();

        if (sesionExiste)
        {
            Navigation.NavigateTo("/inicio");
        }
    }


    private async Task IniciarSesion()
    {
        mensaje = "";
        procesando = true;

        try
        {
            var usuario =
                await AuthService.LoginAsync(
                    username,
                    password
                );

            if (usuario == null)
            {
                mensaje =
                    "Usuario o contraseña incorrectos.";

                return;
            }

            Navigation.NavigateTo("/inicio");
        }
        catch (Exception ex)
        {
            mensaje =
                $"Error de conexión: {ex.Message}";
        }
        finally
        {
            procesando = false;
        }
    }
}