@page "/finalizar-compra"

@using TP6ProgramacionMovil.Models
@using TP6ProgramacionMovil.Services

@inject ClienteService ClienteService
@inject VentaService VentaService
@inject CarritoService CarritoService
@inject AuthService AuthService
@inject NavigationManager Navigation


<MudStack Spacing="4">

    <div>

        <MudText Typo="Typo.h4">
            Finalizar compra
        </MudText>

        <MudText Typo="Typo.body1"
                 Color="Color.Secondary">

            Revisá los datos y confirmá la venta

        </MudText>

    </div>


    @if (cargando)
    {
        <div class="d-flex justify-center pa-8">

            <MudProgressCircular Indeterminate="true"
                                 Color="Color.Primary"
                                 Size="Size.Large" />

        </div>
    }
    else if (!autorizado)
    {
        <MudAlert Severity="Severity.Error">

            Tu usuario no tiene permisos para registrar ventas.

        </MudAlert>
    }
    else if (ventaExitosa)
    {
        <MudPaper Elevation="1"
                  Class="pa-6"
                  Style="border-radius: 20px;">

            <MudStack AlignItems="AlignItems.Center"
                      Spacing="3">

                <MudAvatar Color="Color.Success"
                           Size="Size.Large">

                    <MudIcon Icon="@Icons.Material.Filled.Check" />

                </MudAvatar>


                <MudText Typo="Typo.h5">
                    Venta registrada correctamente
                </MudText>


                <MudText Typo="Typo.body1">

                    Venta N°
                    <strong>@ventaId</strong>

                </MudText>


                <MudText Typo="Typo.h4"
                         Color="Color.Success">

                    $@totalVenta.ToString("N2")

                </MudText>


                <MudChip T="string"
                         Color="Color.Primary"
                         Variant="Variant.Outlined">

                    Pago: @medioPago

                </MudChip>


                <MudStack Row="true"
                          Class="mt-3">

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               OnClick="VolverCatalogo">

                        Volver al catálogo

                    </MudButton>


                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               OnClick="VolverInicio">

                        Ir al inicio

                    </MudButton>

                </MudStack>

            </MudStack>

        </MudPaper>
    }
    else
    {
        @if (!string.IsNullOrEmpty(error))
        {
            <MudAlert Severity="Severity.Error"
                      Class="mb-3">

                @error

            </MudAlert>
        }


        <MudGrid>

            <MudItem xs="12"
                     md="7">

                <MudPaper Elevation="1"
                          Class="pa-5"
                          Style="border-radius: 20px;">

                    <MudText Typo="Typo.h6"
                             Class="mb-4">

                        Datos de la venta

                    </MudText>


                    <MudStack Spacing="4">

                        <MudSelect T="int"
                                   Label="Cliente"
                                   Variant="Variant.Outlined"
                                   @bind-Value="clienteId">

                            <MudSelectItem T="int"
                                           Value="0">

                                Seleccionar cliente...

                            </MudSelectItem>

                            @foreach (var cliente in clientes)
                            {
                                <MudSelectItem T="int"
                                               Value="@cliente.Id">

                                    @TextoCliente(cliente)

                                </MudSelectItem>
                            }

                        </MudSelect>


                        <MudSelect T="string"
                                   Label="Medio de pago"
                                   Variant="Variant.Outlined"
                                   @bind-Value="medioPago">

                            <MudSelectItem T="string"
                                           Value="@string.Empty">

                                Seleccionar...

                            </MudSelectItem>

                            <MudSelectItem T="string"
                                           Value="@("Efectivo")">

                                Efectivo

                            </MudSelectItem>

                            <MudSelectItem T="string"
                                           Value="@("Tarjeta")">

                                Tarjeta

                            </MudSelectItem>

                            <MudSelectItem T="string"
                                           Value="@("Transferencia")">

                                Transferencia

                            </MudSelectItem>

                        </MudSelect>

                    </MudStack>

                </MudPaper>

            </MudItem>


            <MudItem xs="12"
                     md="5">

                <MudPaper Elevation="2"
                          Class="pa-5"
                          Style="border-radius: 20px;">

                    <MudText Typo="Typo.h6"
                             Class="mb-4">

                        Resumen

                    </MudText>


                    <MudStack Spacing="2">

                        @foreach (var item in CarritoService.Items)
                        {
                            <MudStack Row="true"
                                      Justify="Justify.SpaceBetween">

                                <MudText Typo="Typo.body2">

                                    @item.Cantidad x
                                    @item.Producto.Nombre

                                </MudText>


                                <MudText Typo="Typo.body2">

                                    $@item.Subtotal.ToString("N2")

                                </MudText>

                            </MudStack>
                        }


                        <MudDivider Class="my-2" />


                        <MudStack Row="true"
                                  Justify="Justify.SpaceBetween"
                                  AlignItems="AlignItems.Center">

                            <MudText Typo="Typo.h6">
                                Total
                            </MudText>

                            <MudText Typo="Typo.h4"
                                     Color="Color.Primary">

                                $@CarritoService.Total.ToString("N2")

                            </MudText>

                        </MudStack>


                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Success"
                                   Size="Size.Large"
                                   FullWidth="true"
                                   Disabled="@procesando"
                                   StartIcon="@Icons.Material.Filled.CheckCircle"
                                   OnClick="ConfirmarVenta">

                            @(procesando
                                ? "Procesando..."
                                : "Confirmar compra")

                        </MudButton>

                    </MudStack>

                </MudPaper>

            </MudItem>

        </MudGrid>
    }

</MudStack>


@code {

    private List<ClienteResponse> clientes =
        new();

    private int clienteId;

    private string medioPago = "";

    private bool cargando = true;

    private bool procesando;

    private bool autorizado = true;

    private bool ventaExitosa;

    private string error = "";

    private int ventaId;

    private decimal totalVenta;


    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.EstaAutenticado)
        {
            var sesion =
                await AuthService.RestaurarSesionAsync();

            if (!sesion)
            {
                Navigation.NavigateTo(
                    "/login",
                    replace: true
                );

                return;
            }
        }


        if (!AuthService.EsAdmin &&
            !AuthService.EsVendedor)
        {
            autorizado = false;
            cargando = false;

            return;
        }


        if (CarritoService.Items.Count == 0)
        {
            Navigation.NavigateTo(
                "/carrito",
                replace: true
            );

            return;
        }


        try
        {
            clientes =
                await ClienteService
                    .ObtenerClientesAsync();
        }
        catch (Exception ex)
        {
            error =
                $"No se pudieron cargar los clientes: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }


    private async Task ConfirmarVenta()
    {
        error = "";


        if (clienteId == 0)
        {
            error =
                "Debe seleccionar un cliente.";

            return;
        }


        if (string.IsNullOrWhiteSpace(medioPago))
        {
            error =
                "Debe seleccionar un medio de pago.";

            return;
        }


        if (CarritoService.Items.Count == 0)
        {
            error =
                "El carrito está vacío.";

            return;
        }


        procesando = true;


        try
        {
            var venta =
                new VentaRequest
                {
                    ClienteId =
                        clienteId,

                    Detalles =
                        CarritoService.Items
                            .Select(item =>
                                new DetalleVentaRequest
                                {
                                    ProductoId =
                                        item.Producto.Id,

                                    Cantidad =
                                        item.Cantidad
                                })
                            .ToList()
                };


            var resultado =
                await VentaService
                    .RegistrarVentaAsync(venta);


            ventaId =
                resultado.VentaId;

            totalVenta =
                resultado.Total;

            ventaExitosa = true;


            CarritoService.Vaciar();
        }
        catch (Exception ex)
        {
            error =
                $"No se pudo registrar la venta: {ex.Message}";
        }
        finally
        {
            procesando = false;
        }
    }


    private string TextoCliente(
        ClienteResponse cliente)
    {
        if (string.IsNullOrWhiteSpace(
                cliente.Documento))
        {
            return cliente.Nombre;
        }

        return
            $"{cliente.Nombre} - {cliente.Documento}";
    }


    private void VolverCatalogo()
    {
        Navigation.NavigateTo(
            "/catalogo"
        );
    }


    private void VolverInicio()
    {
        Navigation.NavigateTo(
            "/inicio"
        );
    }
}