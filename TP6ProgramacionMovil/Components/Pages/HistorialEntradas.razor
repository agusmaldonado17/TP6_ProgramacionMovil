@page "/historial-entradas"

@using TP6ProgramacionMovil.Models
@using TP6ProgramacionMovil.Services

@inject CompraService CompraService
@inject AuthService AuthService
@inject NavigationManager Navigation


<MudStack Spacing="4">

    <div>

        <MudText Typo="Typo.h4">
            Historial de entradas
        </MudText>

        <MudText Typo="Typo.body1"
                 Color="Color.Secondary">
            Consultá los ingresos de mercadería registrados
        </MudText>

    </div>


    @if (cargando)
    {
        <div class="d-flex justify-center pa-8">

            <MudProgressCircular Indeterminate="true"
                                 Color="Color.Primary"
                                 Size="Size.Large" />

        </div>
    }
    else if (!AuthService.EsAdmin)
    {
        <MudAlert Severity="Severity.Error">
            No tenés permisos para acceder.
        </MudAlert>
    }
    else if (!string.IsNullOrEmpty(error))
    {
        <MudAlert Severity="Severity.Error">
            @error
        </MudAlert>
    }
    else if (compras.Count == 0)
    {
        <MudAlert Severity="Severity.Info">
            No hay entradas registradas.
        </MudAlert>
    }
    else
    {
        @foreach (var compra in compras)
        {
            <MudPaper Elevation="1"
                      Class="pa-5"
                      Style="border-radius:18px;">

                <MudStack Spacing="3">

                    <MudStack Row="true"
                              Justify="Justify.SpaceBetween"
                              AlignItems="AlignItems.Center">

                        <div>

                            <MudText Typo="Typo.h6">
                                Entrada N° @compra.Id
                            </MudText>

                            <MudText Typo="Typo.caption"
                                     Color="Color.Secondary">
                                @compra.Fecha.ToString("dd/MM/yyyy HH:mm")
                            </MudText>

                        </div>


                        <MudText Typo="Typo.h5"
                                 Color="Color.Primary">
                            $@compra.Total.ToString("N2")
                        </MudText>

                    </MudStack>


                    <MudDivider />


                    <MudGrid>

                        <MudItem xs="12" sm="6">

                            <MudText Typo="Typo.caption"
                                     Color="Color.Secondary">
                                Proveedor
                            </MudText>

                            <MudText>
                                @compra.ProveedorNombre
                            </MudText>

                        </MudItem>


                        <MudItem xs="12" sm="6">

                            <MudText Typo="Typo.caption"
                                     Color="Color.Secondary">
                                Registrada por
                            </MudText>

                            <MudText>
                                @compra.UsuarioNombre
                            </MudText>

                        </MudItem>

                    </MudGrid>


                    <MudDivider />


                    @foreach (var detalle in compra.Detalles)
                    {
                        <MudPaper Elevation="0"
                                  Class="pa-3"
                                  Style="background:#F8FAFC; border-radius:12px;">

                            <MudStack Row="true"
                                      Justify="Justify.SpaceBetween">

                                <div>

                                    <MudText>
                                        @detalle.ProductoNombre
                                    </MudText>

                                    <MudText Typo="Typo.caption"
                                             Color="Color.Secondary">

                                        @detalle.Cantidad x
                                        $@detalle.PrecioUnitario.ToString("N2")

                                    </MudText>

                                </div>


                                <MudText Typo="Typo.subtitle2">
                                    $@detalle.Subtotal.ToString("N2")
                                </MudText>

                            </MudStack>

                        </MudPaper>
                    }

                </MudStack>

            </MudPaper>
        }


        <MudPaper Elevation="0"
                  Class="pa-4"
                  Style="border-radius:18px;">

            <MudStack Row="true"
                      Justify="Justify.SpaceBetween"
                      AlignItems="AlignItems.Center">

                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           Disabled="@(paginaActual <= 1)"
                           OnClick="Anterior">
                    Anterior
                </MudButton>

                <MudText>
                    Página @paginaActual de @totalPaginas
                </MudText>

                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           Disabled="@(paginaActual >= totalPaginas)"
                           OnClick="Siguiente">
                    Siguiente
                </MudButton>

            </MudStack>

        </MudPaper>
    }

</MudStack>


@code {

    private List<CompraResponse> compras = new();

    private bool cargando = true;
    private string error = "";

    private int paginaActual = 1;
    private int totalPaginas = 1;


    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.EstaAutenticado)
        {
            var sesion =
                await AuthService.RestaurarSesionAsync();

            if (!sesion)
            {
                Navigation.NavigateTo(
                    "/login",
                    replace: true
                );

                return;
            }
        }

        if (!AuthService.EsAdmin)
        {
            cargando = false;
            return;
        }

        await Cargar();
    }


    private async Task Cargar()
    {
        cargando = true;
        error = "";

        try
        {
            var respuesta =
                await CompraService
                    .ObtenerComprasAsync(
                        paginaActual,
                        20
                    );

            if (respuesta == null)
            {
                error =
                    "No se pudo cargar el historial.";

                return;
            }

            compras = respuesta.Datos;

            paginaActual =
                respuesta.PaginaActual;

            totalPaginas =
                respuesta.TotalPaginas;
        }
        catch (Exception ex)
        {
            error =
                $"Error: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }


    private async Task Anterior()
    {
        if (paginaActual <= 1)
            return;

        paginaActual--;
        await Cargar();
    }


    private async Task Siguiente()
    {
        if (paginaActual >= totalPaginas)
            return;

        paginaActual++;
        await Cargar();
    }
}