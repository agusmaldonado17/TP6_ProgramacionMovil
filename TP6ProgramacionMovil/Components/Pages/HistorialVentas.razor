@page "/historial-ventas"

@using TP6ProgramacionMovil.Models
@using TP6ProgramacionMovil.Services

@inject VentaService VentaService
@inject AuthService AuthService
@inject NavigationManager Navigation

<h1>Historial de ventas</h1>

<div class="mb-3">
    <div class="input-group">

        <input class="form-control"
               placeholder="Buscar por cliente..."
               @bind="busqueda" />

        <button class="btn btn-primary"
                @onclick="Buscar">
            Buscar
        </button>

    </div>
</div>

@if (cargando)
{
    <p>Cargando...</p>
}
else if (!AuthService.EsAdmin && !AuthService.EsVendedor)
{
    <div class="alert alert-danger">
        No tenés permisos para acceder.
    </div>
}
else if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger">
        @error
    </div>
}
else if (ventas.Count == 0)
{
    <div class="alert alert-info">
        No se encontraron ventas.
    </div>
}
else
{
    @foreach (var venta in ventas)
    {
        <div class="card mb-3">

            <div class="card-body">

                <h5>
                    Venta N° @venta.Id
                </h5>

                <div>
                    Fecha:
                    @venta.Fecha.ToString("dd/MM/yyyy HH:mm")
                </div>

                <div>
                    Cliente:
                    <strong>@venta.NombreCliente</strong>
                </div>

                <div>
                    Registrada por:
                    @venta.NombreUsuario
                </div>

                <div class="mt-2">
                    Total:
                    <strong>
                        $@venta.Total.ToString("N2")
                    </strong>
                </div>

                <hr />

                @foreach (var detalle in venta.Detalles)
                {
                    <div class="mb-2">

                        <strong>
                            @detalle.NombreProducto
                        </strong>

                        <div>
                            @detalle.Cantidad x
                            $@detalle.PrecioUnitario.ToString("N2")
                        </div>

                        <div>
                            Subtotal:
                            $@detalle.Subtotal.ToString("N2")
                        </div>

                    </div>
                }

            </div>

        </div>
    }

    <div class="d-flex justify-content-between align-items-center">

        <button class="btn btn-outline-primary"
                disabled="@(paginaActual <= 1)"
                @onclick="Anterior">
            Anterior
        </button>

        <span>
            Página @paginaActual de @totalPaginas
        </span>

        <button class="btn btn-outline-primary"
                disabled="@(paginaActual >= totalPaginas)"
                @onclick="Siguiente">
            Siguiente
        </button>

    </div>
}

@code {

    private List<VentaResponse> ventas = new();

    private string busqueda = "";
    private string error = "";

    private bool cargando = true;

    private int paginaActual = 1;
    private int totalPaginas = 1;


    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.EstaAutenticado)
        {
            var sesion =
                await AuthService.RestaurarSesionAsync();

            if (!sesion)
            {
                Navigation.NavigateTo(
                    "/login",
                    replace: true
                );

                return;
            }
        }

        if (!AuthService.EsAdmin &&
            !AuthService.EsVendedor)
        {
            cargando = false;
            return;
        }

        await Cargar();
    }


    private async Task Cargar()
    {
        cargando = true;
        error = "";

        try
        {
            var respuesta =
                await VentaService.ObtenerVentasAsync(
                    paginaActual,
                    20,
                    busqueda
                );

            if (respuesta == null)
            {
                error =
                    "No se pudo cargar el historial.";

                return;
            }

            ventas = respuesta.Datos;
            paginaActual = respuesta.PaginaActual;
            totalPaginas = respuesta.TotalPaginas;
        }
        catch (Exception ex)
        {
            error = $"Error: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }


    private async Task Buscar()
    {
        paginaActual = 1;
        await Cargar();
    }


    private async Task Anterior()
    {
        if (paginaActual <= 1)
            return;

        paginaActual--;

        await Cargar();
    }


    private async Task Siguiente()
    {
        if (paginaActual >= totalPaginas)
            return;

        paginaActual++;

        await Cargar();
    }
}