@page "/historial-ventas"

@using TP6ProgramacionMovil.Models
@using TP6ProgramacionMovil.Services

@inject VentaService VentaService
@inject AuthService AuthService
@inject NavigationManager Navigation


<MudStack Spacing="4">

    <div>
        <MudText Typo="Typo.h4">
            Historial de ventas
        </MudText>

        <MudText Typo="Typo.body1"
                 Color="Color.Secondary">
            Consultá las ventas registradas
        </MudText>
    </div>


    <MudPaper Elevation="0"
              Class="pa-4"
              Style="border-radius: 18px;">

        <MudStack Row="true" Spacing="2">

            <MudTextField T="string"
                          @bind-Value="busqueda"
                          Placeholder="Buscar por cliente..."
                          Variant="Variant.Outlined"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          FullWidth="true" />

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="Buscar">
                Buscar
            </MudButton>

        </MudStack>

    </MudPaper>


    @if (cargando)
    {
        <div class="d-flex justify-center pa-8">
            <MudProgressCircular Indeterminate="true"
                                 Color="Color.Primary"
                                 Size="Size.Large" />
        </div>
    }
    else if (!AuthService.EsAdmin &&
             !AuthService.EsVendedor)
    {
        <MudAlert Severity="Severity.Error">
            No tenés permisos para acceder.
        </MudAlert>
    }
    else if (!string.IsNullOrEmpty(error))
    {
        <MudAlert Severity="Severity.Error">
            @error
        </MudAlert>
    }
    else if (ventas.Count == 0)
    {
        <MudAlert Severity="Severity.Info">
            No se encontraron ventas.
        </MudAlert>
    }
    else
    {
        @foreach (var venta in ventas)
        {
            <MudPaper Elevation="1"
                      Class="pa-5"
                      Style="border-radius: 18px;">

                <MudStack Spacing="3">

                    <MudStack Row="true"
                              Justify="Justify.SpaceBetween"
                              AlignItems="AlignItems.Center">

                        <div>
                            <MudText Typo="Typo.h6">
                                Venta N° @venta.Id
                            </MudText>

                            <MudText Typo="Typo.caption"
                                     Color="Color.Secondary">
                                @venta.Fecha.ToString("dd/MM/yyyy HH:mm")
                            </MudText>
                        </div>

                        <MudText Typo="Typo.h5"
                                 Color="Color.Primary">
                            $@venta.Total.ToString("N2")
                        </MudText>

                    </MudStack>


                    <MudDivider />


                    <MudGrid>

                        <MudItem xs="12" sm="6">
                            <MudText Typo="Typo.caption"
                                     Color="Color.Secondary">
                                Cliente
                            </MudText>

                            <MudText Typo="Typo.body1">
                                @venta.NombreCliente
                            </MudText>
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudText Typo="Typo.caption"
                                     Color="Color.Secondary">
                                Registrada por
                            </MudText>

                            <MudText Typo="Typo.body1">
                                @venta.NombreUsuario
                            </MudText>
                        </MudItem>

                    </MudGrid>


                    <MudDivider />


                    <MudText Typo="Typo.subtitle2">
                        Productos
                    </MudText>


                    @foreach (var detalle in venta.Detalles)
                    {
                        <MudPaper Elevation="0"
                                  Class="pa-3"
                                  Style="background:#F8FAFC; border-radius:12px;">

                            <MudStack Row="true"
                                      Justify="Justify.SpaceBetween">

                                <div>
                                    <MudText Typo="Typo.body1">
                                        @detalle.NombreProducto
                                    </MudText>

                                    <MudText Typo="Typo.caption"
                                             Color="Color.Secondary">
                                        @detalle.Cantidad x
                                        $@detalle.PrecioUnitario.ToString("N2")
                                    </MudText>
                                </div>

                                <MudText Typo="Typo.subtitle2">
                                    $@detalle.Subtotal.ToString("N2")
                                </MudText>

                            </MudStack>

                        </MudPaper>
                    }

                </MudStack>

            </MudPaper>
        }


        <MudPaper Elevation="0"
                  Class="pa-4"
                  Style="border-radius: 18px;">

            <MudStack Row="true"
                      Justify="Justify.SpaceBetween"
                      AlignItems="AlignItems.Center">

                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           Disabled="@(paginaActual <= 1)"
                           StartIcon="@Icons.Material.Filled.ChevronLeft"
                           OnClick="Anterior">
                    Anterior
                </MudButton>

                <MudText>
                    Página @paginaActual de @totalPaginas
                </MudText>

                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           Disabled="@(paginaActual >= totalPaginas)"
                           EndIcon="@Icons.Material.Filled.ChevronRight"
                           OnClick="Siguiente">
                    Siguiente
                </MudButton>

            </MudStack>

        </MudPaper>
    }

</MudStack>


@code {

    private List<VentaResponse> ventas = new();

    private string busqueda = "";
    private string error = "";

    private bool cargando = true;

    private int paginaActual = 1;
    private int totalPaginas = 1;


    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.EstaAutenticado)
        {
            var sesion =
                await AuthService.RestaurarSesionAsync();

            if (!sesion)
            {
                Navigation.NavigateTo(
                    "/login",
                    replace: true
                );

                return;
            }
        }

        if (!AuthService.EsAdmin &&
            !AuthService.EsVendedor)
        {
            cargando = false;
            return;
        }

        await Cargar();
    }


    private async Task Cargar()
    {
        cargando = true;
        error = "";

        try
        {
            var respuesta =
                await VentaService.ObtenerVentasAsync(
                    paginaActual,
                    20,
                    busqueda
                );

            if (respuesta == null)
            {
                error =
                    "No se pudo cargar el historial.";

                return;
            }

            ventas = respuesta.Datos;
            paginaActual = respuesta.PaginaActual;
            totalPaginas = respuesta.TotalPaginas;
        }
        catch (Exception ex)
        {
            error = $"Error: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }


    private async Task Buscar()
    {
        paginaActual = 1;
        await Cargar();
    }


    private async Task Anterior()
    {
        if (paginaActual <= 1)
            return;

        paginaActual--;
        await Cargar();
    }


    private async Task Siguiente()
    {
        if (paginaActual >= totalPaginas)
            return;

        paginaActual++;
        await Cargar();
    }
}