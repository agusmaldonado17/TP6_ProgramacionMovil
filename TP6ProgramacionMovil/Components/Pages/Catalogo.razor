@page "/catalogo"

@using TP6ProgramacionMovil.Models
@using TP6ProgramacionMovil.Services

@inject ProductoService ProductoService
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject CarritoService CarritoService
@inject ISnackbar Snackbar


<MudStack Spacing="4">

    <div>
        <MudText Typo="Typo.h4">
            Catálogo
        </MudText>

        <MudText Typo="Typo.body1"
                 Color="Color.Secondary">
            Explorá los productos disponibles
        </MudText>
    </div>


    <MudPaper Elevation="0"
              Class="pa-4"
              Style="border-radius: 18px;">

        <MudStack Row="true"
                  Spacing="2">

            <MudTextField T="string"
                          @bind-Value="busqueda"
                          Placeholder="Buscar producto..."
                          Variant="Variant.Outlined"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          FullWidth="true" />

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="Buscar">

                Buscar

            </MudButton>

        </MudStack>

    </MudPaper>


    @if (cargando)
    {
        <div class="d-flex justify-center pa-8">

            <MudProgressCircular Indeterminate="true"
                                 Color="Color.Primary"
                                 Size="Size.Large" />

        </div>
    }
    else if (!string.IsNullOrEmpty(error))
    {
        <MudAlert Severity="Severity.Error">
            @error
        </MudAlert>
    }
    else if (productos.Count == 0)
    {
        <MudAlert Severity="Severity.Info">
            No se encontraron productos.
        </MudAlert>
    }
    else
    {
        <MudGrid>

            @foreach (var producto in productos)
            {
                var imagen =
                    ProductoService
                        .ObtenerUrlImagen(producto);

                <MudItem xs="12"
                         sm="6"
                         md="4"
                         lg="3">

                    <MudCard Style="height: 100%; border-radius: 18px; overflow: hidden;">

                        <div style="
                            height: 190px;
                            background: #F8FAFC;
                            display: flex;
                            align-items: center;
                            justify-content: center;
                            overflow: hidden;">

                            @if (!string.IsNullOrEmpty(imagen))
                            {
                                <img src="@imagen"
                                     alt="@producto.Nombre"
                                     style="
                                width: 100%;
                                height: 100%;
                                object-fit: contain;
                                padding: 12px;" />
                            }
                            else
                            {
                                <MudStack AlignItems="AlignItems.Center"
                                          Spacing="1">

                                    <MudIcon Icon="@Icons.Material.Filled.ImageNotSupported"
                                             Size="Size.Large"
                                             Color="Color.Secondary" />

                                    <MudText Typo="Typo.caption"
                                             Color="Color.Secondary">
                                        Sin imagen
                                    </MudText>

                                </MudStack>
                            }

                        </div>


                        <MudCardContent>

                            <MudText Typo="Typo.caption"
                                     Color="Color.Secondary">

                                @producto.CategoriaNombre

                            </MudText>


                            <MudText Typo="Typo.h6"
                                     Class="mt-1">

                                @producto.Nombre

                            </MudText>


                            @if (!string.IsNullOrWhiteSpace(
                                    producto.Descripcion))
                            {
                                <MudText Typo="Typo.body2"
                                         Color="Color.Secondary"
                                         Class="mt-1 mb-3">

                                    @producto.Descripcion

                                </MudText>
                            }


                            <MudText Typo="Typo.h5"
                                     Class="mt-3 mb-2">

                                $@producto.PrecioVenta.ToString("N2")

                            </MudText>


                            @if (producto.StockActual > 0)
                            {
                                <MudChip T="string"
                                         Size="Size.Small"
                                         Color="Color.Success"
                                         Variant="Variant.Outlined">

                                    Stock: @producto.StockActual

                                </MudChip>
                            }
                            else
                            {
                                <MudChip T="string"
                                         Size="Size.Small"
                                         Color="Color.Error"
                                         Variant="Variant.Outlined">

                                    Sin stock

                                </MudChip>
                            }

                        </MudCardContent>


                        <MudCardActions Class="pa-4 pt-0">

                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       FullWidth="true"
                                       Disabled="@(producto.StockActual <= 0)"
                                       StartIcon="@Icons.Material.Filled.AddShoppingCart"
                                       OnClick="@(() => AgregarAlCarrito(producto))">

                                Agregar al carrito

                            </MudButton>

                        </MudCardActions>

                    </MudCard>

                </MudItem>
            }

        </MudGrid>


        <MudPaper Elevation="0"
                  Class="pa-4 mt-4"
                  Style="border-radius: 18px;">

            <MudStack Row="true"
                      Justify="Justify.SpaceBetween"
                      AlignItems="AlignItems.Center">

                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           Disabled="@(!tieneAnterior)"
                           StartIcon="@Icons.Material.Filled.ChevronLeft"
                           OnClick="PaginaAnterior">

                    Anterior

                </MudButton>


                <MudText Typo="Typo.body2">
                    Página @paginaActual de @totalPaginas
                </MudText>


                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           Disabled="@(!tieneSiguiente)"
                           EndIcon="@Icons.Material.Filled.ChevronRight"
                           OnClick="PaginaSiguiente">

                    Siguiente

                </MudButton>

            </MudStack>

        </MudPaper>
    }

</MudStack>


@code {

    private List<ProductoResponse> productos = new();

    private bool cargando = true;

    private string error = "";

    private string busqueda = "";

    private int paginaActual = 1;

    private int totalPaginas = 1;

    private bool tieneAnterior;

    private bool tieneSiguiente;


    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.EstaAutenticado)
        {
            var sesion =
                await AuthService.RestaurarSesionAsync();

            if (!sesion)
            {
                Navigation.NavigateTo(
                    "/login",
                    replace: true
                );

                return;
            }
        }

        await CargarProductos();
    }


    private async Task CargarProductos()
    {
        cargando = true;
        error = "";

        try
        {
            var respuesta =
                await ProductoService
                    .ObtenerProductosAsync(
                        paginaActual,
                        20,
                        busqueda
                    );

            if (respuesta == null)
            {
                error =
                    "No se pudieron cargar los productos.";

                return;
            }

            productos =
                respuesta.Datos;

            paginaActual =
                respuesta.PaginaActual;

            totalPaginas =
                respuesta.TotalPaginas;

            tieneAnterior =
                respuesta.TienePaginaAnterior;

            tieneSiguiente =
                respuesta.TienePaginaSiguiente;
        }
        catch (Exception ex)
        {
            error =
                $"Error al cargar productos: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }


    private async Task Buscar()
    {
        paginaActual = 1;

        await CargarProductos();
    }


    private async Task PaginaAnterior()
    {
        if (paginaActual <= 1)
            return;

        paginaActual--;

        await CargarProductos();
    }


    private async Task PaginaSiguiente()
    {
        if (!tieneSiguiente)
            return;

        paginaActual++;

        await CargarProductos();
    }


    private void AgregarAlCarrito(
        ProductoResponse producto)
    {
        var agregado =
            CarritoService
                .AgregarProducto(producto);

        if (agregado)
        {
            Snackbar.Add(
                $"{producto.Nombre} agregado al carrito.",
                Severity.Success
            );
        }
        else
        {
            Snackbar.Add(
                "No hay más stock disponible.",
                Severity.Warning
            );
        }
    }
}