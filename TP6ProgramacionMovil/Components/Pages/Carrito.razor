@page "/carrito"

@using TP6ProgramacionMovil.Services

@inject CarritoService CarritoService
@inject AuthService AuthService
@inject NavigationManager Navigation


<MudStack Spacing="4">

    <div>

        <MudText Typo="Typo.h4">
            Carrito
        </MudText>

        <MudText Typo="Typo.body1"
                 Color="Color.Secondary">

            Revisá los productos antes de finalizar la compra

        </MudText>

    </div>


    @if (CarritoService.Items.Count == 0)
    {
        <MudPaper Elevation="0"
                  Class="pa-8 text-center"
                  Style="border-radius: 20px;">

            <MudIcon Icon="@Icons.Material.Filled.ShoppingCart"
                     Size="Size.Large"
                     Color="Color.Secondary"
                     Class="mb-3" />

            <MudText Typo="Typo.h6">
                Tu carrito está vacío
            </MudText>

            <MudText Typo="Typo.body2"
                     Color="Color.Secondary"
                     Class="mb-4">

                Agregá productos desde el catálogo

            </MudText>


            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Storefront"
                       OnClick="VolverCatalogo">

                Ver productos

            </MudButton>

        </MudPaper>
    }
    else
    {
        <MudGrid>

            <MudItem xs="12"
                     md="8">

                <MudStack Spacing="3">

                    @foreach (var item in CarritoService.Items)
                    {
                        <MudPaper Elevation="1"
                                  Class="pa-4"
                                  Style="border-radius: 18px;">

                            <MudGrid>

                                <MudItem xs="12"
                                         sm="7">

                                    <MudText Typo="Typo.h6">
                                        @item.Producto.Nombre
                                    </MudText>


                                    <MudText Typo="Typo.body2"
                                             Color="Color.Secondary">

                                        Precio unitario:
                                        $@item.Producto.PrecioVenta.ToString("N2")

                                    </MudText>


                                    <MudText Typo="Typo.caption"
                                             Color="Color.Secondary">

                                        Stock disponible:
                                        @item.Producto.StockActual

                                    </MudText>

                                </MudItem>


                                <MudItem xs="12"
                                         sm="5">

                                    <MudStack AlignItems="AlignItems.End"
                                              Spacing="2">

                                        <MudStack Row="true"
                                                  AlignItems="AlignItems.Center">

                                            <MudButton Variant="Variant.Outlined"
                                                       Color="Color.Primary"
                                                       OnClick="@(() => Disminuir(item.Producto.Id))">

                                                <MudIcon Icon="@Icons.Material.Filled.Remove" />

                                            </MudButton>


                                            <MudText Typo="Typo.h6"
                                                     Class="px-3">

                                                @item.Cantidad

                                            </MudText>


                                            <MudButton Variant="Variant.Outlined"
                                                       Color="Color.Primary"
                                                       Disabled="@(item.Cantidad >= item.Producto.StockActual)"
                                                       OnClick="@(() => Aumentar(item.Producto.Id))">

                                                <MudIcon Icon="@Icons.Material.Filled.Add" />

                                            </MudButton>

                                        </MudStack>


                                        <MudText Typo="Typo.subtitle1">

                                            Subtotal:
                                            <strong>
                                                $@item.Subtotal.ToString("N2")
                                            </strong>

                                        </MudText>


                                        <MudButton Variant="Variant.Text"
                                                   Color="Color.Error"
                                                   StartIcon="@Icons.Material.Filled.Delete"
                                                   OnClick="@(() => Eliminar(item.Producto.Id))">

                                            Eliminar

                                        </MudButton>

                                    </MudStack>

                                </MudItem>

                            </MudGrid>

                        </MudPaper>
                    }

                </MudStack>

            </MudItem>


            <MudItem xs="12"
                     md="4">

                <MudPaper Elevation="2"
                          Class="pa-5"
                          Style="border-radius: 20px;">

                    <MudStack Spacing="3">

                        <MudText Typo="Typo.h6">
                            Resumen
                        </MudText>


                        <MudStack Row="true"
                                  Justify="Justify.SpaceBetween">

                            <MudText>
                                Productos
                            </MudText>

                            <MudText>
                                @CarritoService.CantidadTotal
                            </MudText>

                        </MudStack>


                        <MudDivider />


                        <MudStack Row="true"
                                  Justify="Justify.SpaceBetween"
                                  AlignItems="AlignItems.Center">

                            <MudText Typo="Typo.h6">
                                Total
                            </MudText>

                            <MudText Typo="Typo.h5"
                                     Color="Color.Primary">

                                $@CarritoService.Total.ToString("N2")

                            </MudText>

                        </MudStack>


                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Success"
                                   Size="Size.Large"
                                   FullWidth="true"
                                   StartIcon="@Icons.Material.Filled.Payment"
                                   OnClick="FinalizarCompra">

                            Finalizar compra

                        </MudButton>


                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Error"
                                   FullWidth="true"
                                   StartIcon="@Icons.Material.Filled.DeleteSweep"
                                   OnClick="VaciarCarrito">

                            Vaciar carrito

                        </MudButton>

                    </MudStack>

                </MudPaper>

            </MudItem>

        </MudGrid>
    }

</MudStack>


@code {

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.EstaAutenticado)
        {
            var sesion =
                await AuthService.RestaurarSesionAsync();

            if (!sesion)
            {
                Navigation.NavigateTo(
                    "/login",
                    replace: true
                );
            }
        }
    }


    private void Aumentar(int id)
    {
        CarritoService.AumentarCantidad(id);
    }


    private void Disminuir(int id)
    {
        CarritoService.DisminuirCantidad(id);
    }


    private void Eliminar(int id)
    {
        CarritoService.EliminarProducto(id);
    }


    private void VaciarCarrito()
    {
        CarritoService.Vaciar();
    }


    private void VolverCatalogo()
    {
        Navigation.NavigateTo("/catalogo");
    }


    private void FinalizarCompra()
    {
        Navigation.NavigateTo("/finalizar-compra");
    }
}