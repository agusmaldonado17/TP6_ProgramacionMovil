@inherits LayoutComponentBase
@implements IDisposable

@inject AuthService AuthService
@inject NavigationManager Navigation


<MudThemeProvider Theme="@tema" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />


@if (AuthService.UsuarioActual == null)
{
    @Body
}
else
{
    <MudLayout>

        <MudAppBar Elevation="0"
                   Color="Color.Primary"
                   Dense="true">

            <MudIconButton Icon="@Icons.Material.Filled.Menu"
                           Color="Color.Inherit"
                           Edge="Edge.Start"
                           OnClick="ToggleDrawer" />

            <MudText Typo="Typo.h6"
                     Class="ml-2"
                     Style="white-space: nowrap;">
                App de Stock
            </MudText>

            <MudSpacer />

            <MudHidden Breakpoint="Breakpoint.Xs">
                <MudText Typo="Typo.body2"
                         Style="
                            max-width: 180px;
                            overflow: hidden;
                            text-overflow: ellipsis;
                            white-space: nowrap;">
                    @AuthService.UsuarioActual.Nombre
                </MudText>
            </MudHidden>

            <MudIconButton Icon="@Icons.Material.Filled.AccountCircle"
                           Color="Color.Inherit"
                           Edge="Edge.End" />

        </MudAppBar>


            <MudDrawer @bind-Open="drawerAbierto"
                       Variant="DrawerVariant.Mini"
                       Breakpoint="Breakpoint.Md"
                       Elevation="1"
                       OpenMiniOnHover="true">

            <NavMenu />

        </MudDrawer>


        <MudMainContent>

            <MudContainer MaxWidth="MaxWidth.ExtraLarge"
                          Class="pa-3 pt-4">

                @Body

            </MudContainer>

        </MudMainContent>

    </MudLayout>
}


@code {

    private bool drawerAbierto = true;


    private readonly MudTheme tema = new()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = "#2563EB",
            Secondary = "#0F172A",
            Background = "#F8FAFC",
            Surface = "#FFFFFF",
            AppbarBackground = "#2563EB",
            AppbarText = "#FFFFFF",
            TextPrimary = "#0F172A",
            TextSecondary = "#64748B"
        }
    };


    protected override void OnInitialized()
    {
        AuthService.OnAuthStateChanged += Actualizar;

        Navigation.LocationChanged += CambioPagina;
    }


    private void ToggleDrawer()
    {
        drawerAbierto = !drawerAbierto;
    }


    private void CambioPagina(
        object? sender,
        LocationChangedEventArgs e)
    {
        drawerAbierto = false;

        InvokeAsync(StateHasChanged);
    }


    private void Actualizar()
    {
        InvokeAsync(StateHasChanged);
    }


    public void Dispose()
    {
        AuthService.OnAuthStateChanged -= Actualizar;

        Navigation.LocationChanged -= CambioPagina;
    }
}