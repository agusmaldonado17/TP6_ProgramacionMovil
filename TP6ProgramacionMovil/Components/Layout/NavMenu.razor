@implements IDisposable

@inject AuthService AuthService
@inject NavigationManager Navigation
@inject CarritoService CarritoService

@using TP6ProgramacionMovil.Services


@if (AuthService.UsuarioActual != null)
{
    <MudDrawerHeader Class="pa-4">

        <MudStack Row="true"
                  AlignItems="AlignItems.Center"
                  Spacing="2">

            <MudAvatar Color="Color.Primary"
                       Size="Size.Medium">

                @InicialUsuario

            </MudAvatar>

            <div>

                <MudText Typo="Typo.subtitle2">
                    @AuthService.UsuarioActual.Nombre
                </MudText>

                <MudText Typo="Typo.caption"
                         Color="Color.Secondary">
                    @AuthService.UsuarioActual.Rol
                </MudText>

            </div>

        </MudStack>

    </MudDrawerHeader>


    <MudDivider />


    <MudNavMenu Dense="true"
                Color="Color.Primary"
                Class="pa-2">

        <MudNavLink Href="/inicio"
                    Icon="@Icons.Material.Filled.Home">

            Inicio

        </MudNavLink>


        <MudNavLink Href="/catalogo"
                    Icon="@Icons.Material.Filled.Storefront">

            Catálogo

        </MudNavLink>


        <MudNavLink Href="/carrito"
                    Icon="@Icons.Material.Filled.ShoppingCart">

            Carrito (@CarritoService.CantidadTotal)

        </MudNavLink>


        @if (AuthService.EsAdmin ||
             AuthService.EsVendedor)
        {
            <MudDivider Class="my-2" />

            <MudText Typo="Typo.overline"
                     Color="Color.Secondary"
                     Class="px-4 py-2">

                Ventas

            </MudText>


            <MudNavLink Href="/historial-ventas"
                        Icon="@Icons.Material.Filled.ReceiptLong">

                Historial de ventas

            </MudNavLink>
        }


        @if (AuthService.EsAdmin)
        {
            <MudDivider Class="my-2" />

            <MudText Typo="Typo.overline"
                     Color="Color.Secondary"
                     Class="px-4 py-2">

                Administración

            </MudText>


            <MudNavLink Href="/entrada-mercaderia"
                        Icon="@Icons.Material.Filled.AddBox">

                Entrada de mercadería

            </MudNavLink>


            <MudNavLink Href="/historial-entradas"
                        Icon="@Icons.Material.Filled.History">

                Historial de entradas

            </MudNavLink>


            <MudNavLink Href="/reportes"
                        Icon="@Icons.Material.Filled.Description">

                Reportes

            </MudNavLink>
        }


        <MudDivider Class="my-2" />


        <MudNavLink Icon="@Icons.Material.Filled.Logout"
                    OnClick="CerrarSesion">

            Cerrar sesión

        </MudNavLink>

    </MudNavMenu>
}


@code {

    private string InicialUsuario =>
        string.IsNullOrWhiteSpace(
            AuthService.UsuarioActual?.Nombre)
            ? "U"
            : AuthService.UsuarioActual.Nombre
                .Substring(0, 1)
                .ToUpper();


    protected override void OnInitialized()
    {
        AuthService.OnAuthStateChanged += Actualizar;

        CarritoService.OnCarritoChanged += Actualizar;
    }


    private void Actualizar()
    {
        InvokeAsync(StateHasChanged);
    }


    private void CerrarSesion()
    {
        AuthService.Logout();

        Navigation.NavigateTo(
            "/login",
            replace: true
        );
    }


    public void Dispose()
    {
        AuthService.OnAuthStateChanged -= Actualizar;

        CarritoService.OnCarritoChanged -= Actualizar;
    }
}